--- !u!114 &898501634
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 898501632}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ade2712d1146720459a67d14ff817156, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: Mother Cat
    dialogueText: Oh thank you so much for freeing me!
    speakerPortrait: {fileID: 3312542217912747725, guid: 98ab0bf0974325f468fa1757491447de, type: 3}
  - speakerName: Patch
    dialogueText: No need for thanks
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
  - speakerName: Patch
    dialogueText: We've got to get you back to your kittens
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
  - speakerName: Mother Cat
    dialogueText: Wait I can't go back up there!
    speakerPortrait: {fileID: 3312542217912747725, guid: 98ab0bf0974325f468fa1757491447de, type: 3}
  - speakerName: Mother Cat
    dialogueText: That brute is still up there...
    speakerPortrait: {fileID: 3312542217912747725, guid: 98ab0bf0974325f468fa1757491447de, type: 3}
  - speakerName: Mother Cat
    dialogueText: I'm too injured to fight him again
    speakerPortrait: {fileID: 3312542217912747725, guid: 98ab0bf0974325f468fa1757491447de, type: 3}
  - speakerName: Mother Cat
    dialogueText: 'I''m sorry but could I ask you to deal with the dog before I get
      back to my kittens? '
    speakerPortrait: {fileID: 3312542217912747725, guid: 98ab0bf0974325f468fa1757491447de, type: 3}
  - speakerName: Patch
    dialogueText: Alright, I'll find a way to make him leave or something
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
  - speakerName: Patch
    dialogueText: In the meantime, just stay here until I come back for you
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
  - speakerName: Mother Cat
    dialogueText: Thank you so much! Be careful!
    speakerPortrait: {fileID: 3312542217912747725, guid: 98ab0bf0974325f468fa1757491447de, type: 3}
  dialoguePanel: {fileID: 741082908}
