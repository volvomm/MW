  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b7dad1ce2ce175c46b9e4f514b9d6ce0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: Patch
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    sentence: He-he-
  - speakerName: Patch
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    sentence: Hello Mr dog, why are you standing in front of the door?
  - speakerName: Devil Dog
    speakerPortrait: {fileID: -1192571620878233729, guid: d2e493c250bcf7245ad97022c6b85393, type: 3}
    sentence: It isn't any of your business kid.
  - speakerName: Devil Dog
    speakerPortrait: {fileID: -1192571620878233729, guid: d2e493c250bcf7245ad97022c6b85393, type: 3}
    sentence: But I'm merely looking for three little kittens and I'm guarding the
      door so they can't escape this place.
  - speakerName: Patch
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    sentence: Why are you trying to find these kittens? What did they do?
  - speakerName: Devil Dog
    speakerPortrait: {fileID: -1192571620878233729, guid: d2e493c250bcf7245ad97022c6b85393, type: 3}
    sentence: It's none of your damm business you nosy little gremlin!
  - speakerName: Devil Dog
    speakerPortrait: {fileID: -1192571620878233729, guid: d2e493c250bcf7245ad97022c6b85393, type: 3}
    sentence: You better scram before I decide to shift my focus to you!
  dialoguePanel: {fileID: 741082908}
