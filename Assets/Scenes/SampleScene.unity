  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 42fb597a596533343ad4870233b8d802, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  coveredCage: {fileID: 373732047}
  cage: {fileID: 890463440}
  motherCat: {fileID: 186976885}
  dialoguePanel: {fileID: 741082908}
  dialogueText: {fileID: 1219159426}
  nameText: {fileID: 1258714718}
  portraitImage: {fileID: 252152096}
  patchPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
  motherCatPortrait: {fileID: 3312542217912747725, guid: 98ab0bf0974325f468fa1757491447de, type: 3}
  dialogueLines:
  - speaker: 0
    text: Oh!
  - speaker: 1
    text: Hello?
  - speaker: 1
    text: Are you real?
  - speaker: 1
    text: Please help me!
  - speaker: 0
    text: Don't worry.
  - speaker: 0
    text: I'm here to get you out of here.
  - speaker: 1
    text: Oh thank you!
  - speaker: 1
    text: Ever since I fought that monster...
  - speaker: 1
    text: Wait...
  - speaker: 1
    text: Are my children okay?
  - speaker: 0
    text: Yes they are.
  - speaker: 0
    text: They're by the entrance of this place
  - speaker: 0
    text: They're away from the dog that attacked you.
  - speaker: 1
    text: Oh thank you for such good news!
  - speaker: 0
    text: Well.
  - speaker: 0
    text: Have you gotten any ideas on how this thing opens up?
  - speaker: 1
    text: I'm not too sure
  - speaker: 1
    text: But I remember seeing a box in the other room with a bunch of numbers
  - speaker: 1
    text: I think only the last number worked when I put in my lucky number
  - speaker: 0
    text: What's the lucky number?
  - speaker: 1
    text: It's four.
  - speaker: 1
    text: It's the number that counted up me and my children before we got attacked.
  - speaker: 0
    text: Don't worry. I'll try my best to get you out of here.
  - speaker: 1
    text: Oh thank you!
  - speaker: 1
    text: Be careful of that vicious monster!
  typingSpeed: 0.04
