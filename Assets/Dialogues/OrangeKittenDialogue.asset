  m_Script: {fileID: 11500000, guid: d2092518b5bf43146b029354e654ff5b, type: 3}
  m_Name: OrangeKittenDialogue
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: Patch
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    dialogueText: Do you remember if your mom had told you a number from a box from
      her closet?
  - speakerName: Orange Kitten
    speakerPortrait: {fileID: 7289357142524839309, guid: ca74249eb4b4dce47a5fa36a5317ee7f, type: 3}
    dialogueText: Mama told me to pick a number for the box and I chose six!
  - speakerName: Patch
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    dialogueText: Number six huh...
  typingSpeed: 0.07
