MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d2092518b5bf43146b029354e654ff5b, type: 3}
  m_Name: GrayKittenDialogue
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: Patch
    speakerPortrait: {fileID: -6874673969537961856, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    dialogueText: Don't worry.
  - speakerName: Patch
    speakerPortrait: {fileID: -6874673969537961856, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    dialogueText: I'll try and bring your mom back.
  - speakerName: Gray Kitten
    speakerPortrait: {fileID: -4282008722113011192, guid: ad4fa09df7808924ea0bac5aa7b98f90, type: 3}
    dialogueText: Please do sir.
  - speakerName: Gray Kitten
    speakerPortrait: {fileID: -4282008722113011192, guid: ad4fa09df7808924ea0bac5aa7b98f90, type: 3}
    dialogueText: My siblings are afraid and so am I.
  - speakerName: Gray Kitten
    speakerPortrait: {fileID: -4282008722113011192, guid: ad4fa09df7808924ea0bac5aa7b98f90, type: 3}
    dialogueText: I'm just trying to be brave for them
  - speakerName: Gray Kitten
    speakerPortrait: {fileID: -4282008722113011192, guid: ad4fa09df7808924ea0bac5aa7b98f90, type: 3}
    dialogueText: But the thing is
  - speakerName: Gray Kitten
    speakerPortrait: {fileID: -4282008722113011192, guid: ad4fa09df7808924ea0bac5aa7b98f90, type: 3}
    dialogueText: I'm also really scared...
  typingSpeed: 0.07
