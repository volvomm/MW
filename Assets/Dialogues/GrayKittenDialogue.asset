  m_Script: {fileID: 11500000, guid: d2092518b5bf43146b029354e654ff5b, type: 3}
  m_Name: GrayKittenDialogue
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: Patch
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    dialogueText: Hey little one, I found your mom and she told me that you know
      a number from her digit box that she store in the closet.
  - speakerName: Gray Kitten
    speakerPortrait: {fileID: -4282008722113011192, guid: ad4fa09df7808924ea0bac5aa7b98f90, type: 3}
    dialogueText: I remember that box. Mom used to press three
  - speakerName: Patch
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    dialogueText: Three huh.
  - speakerName: Gray Kitten
    speakerPortrait: {fileID: -4282008722113011192, guid: ad4fa09df7808924ea0bac5aa7b98f90, type: 3}
    dialogueText: 'Mama always told us that she''d use the last number, whatever
      that means. '
  typingSpeed: 0.07
