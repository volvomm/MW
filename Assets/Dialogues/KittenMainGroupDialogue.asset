%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d2092518b5bf43146b029354e654ff5b, type: 3}
  m_Name: KittenMainGroupDialogue
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: Patch
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    dialogueText: Hey, What are you guys doing here? And where are your parents?
  - speakerName: White Kitten
    speakerPortrait: {fileID: 7468802606173327562, guid: 9ed38ae8574c50e44810e93a4a0eff55, type: 3}
    dialogueText: Oh sir! Please help our mom
  - speakerName: Patch
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    dialogueText: Wait... What do you mean by help your mom?
  - speakerName: Orange Kitten
    speakerPortrait: {fileID: 7289357142524839309, guid: ca74249eb4b4dce47a5fa36a5317ee7f, type: 3}
    dialogueText: Let me explain.
  - speakerName: Orange Kitten
    speakerPortrait: {fileID: 7289357142524839309, guid: ca74249eb4b4dce47a5fa36a5317ee7f, type: 3}
    dialogueText: Our mom and us live in this house
  - speakerName: Orange Kitten
    speakerPortrait: {fileID: 7289357142524839309, guid: ca74249eb4b4dce47a5fa36a5317ee7f, type: 3}
    dialogueText: And not too long ago, this big bad dog broke in and attacked us!
  - speakerName: Orange Kitten
    speakerPortrait: {fileID: 7289357142524839309, guid: ca74249eb4b4dce47a5fa36a5317ee7f, type: 3}
    dialogueText: But our mom protected us from the bad dog!
  - speakerName: White Kitten
    speakerPortrait: {fileID: 7468802606173327562, guid: 9ed38ae8574c50e44810e93a4a0eff55, type: 3}
    dialogueText: But in the process, she got injured and the dog pulled her away!
  - speakerName: Gray Kitten
    speakerPortrait: {fileID: -4282008722113011192, guid: ad4fa09df7808924ea0bac5aa7b98f90, type: 3}
    dialogueText: And now we're just waiting here since we can't fight against that
      monster.
  - speakerName: Gray Kitten
    speakerPortrait: {fileID: -4282008722113011192, guid: ad4fa09df7808924ea0bac5aa7b98f90, type: 3}
    dialogueText: And that's what happened. Could you please help us and find our
      mom for us?
  - speakerName: Patch
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    dialogueText: 'You poor things. Okay I''ll see if I can get your mom back. '
  - speakerName: White Kitten
    speakerPortrait: {fileID: 7468802606173327562, guid: 9ed38ae8574c50e44810e93a4a0eff55, type: 3}
    dialogueText: We're counting on your mister!
  typingSpeed: 0.07
