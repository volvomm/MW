  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d2092518b5bf43146b029354e654ff5b, type: 3}
  m_Name: WhiteKittenDialogue
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: Patch
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    dialogueText: Hey, I heard from your mom that you may know a digit from her number
      box?
  - speakerName: White Kitten
    speakerPortrait: {fileID: 7468802606173327562, guid: 9ed38ae8574c50e44810e93a4a0eff55, type: 3}
    dialogueText: A number...?
  - speakerName: White Kitten
    speakerPortrait: {fileID: 7468802606173327562, guid: 9ed38ae8574c50e44810e93a4a0eff55, type: 3}
    dialogueText: Oh right I remember! When I was watching mama set the number code,
      I saw number nine!
  - speakerName: Patch
    speakerPortrait: {fileID: 21300000, guid: df2987c3ff729bc479afcc5c5f174e97, type: 3}
    dialogueText: 'Nine... '
  typingSpeed: 0.07
